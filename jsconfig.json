{
  // Base options for `npm run typecheck` (scripts/typecheck.mjs), which extends this config once
  // per page with that page's scripts from _partials/app-pages.json. Classic scripts share one
  // global scope, so one config for all of js/ would give false "redeclared" errors.
  // The "files" list below (day-closing.html's set) is only for editors and `tsc -p jsconfig.json`.
  // DB types: types/db.d.ts (scripts/gen-db-types.sh).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    // ~600 untyped parameters; turn on per file as JSDoc lands.
    "noImplicitAny": false,
    // JS catch blocks read err.message freely; keep catch variables `any`.
    "useUnknownInCatchVariables": false,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "types/globals.d.ts",
    "js/roleBootstrap.js",
    "js/appNav.js",
    "js/errorHandler.js",
    "js/appDialog.js",
    "js/cache.js",
    "js/appConfig.js",
    "js/purchaseTaxUtils.js",
    "js/utils.js",
    "js/pwa.js",
    "js/queryPages.js",
    "js/creditCustomerSearch.js",
    "js/pumpSettings.js",
    "js/printUtils.js",
    "js/pageSections.js",
    "js/dayClosingMath.js",
    "js/auth.js",
    "js/taskUtils.js",
    "js/dsrQueries.js",
    "js/notifications.js",
    "js/day-closing.js"
  ]
}
