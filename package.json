{
  "name": "petrol-pump",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:images": "node scripts/optimize-images.mjs",
    "build:html": "node scripts/build-html.mjs",
    "stamp": "node scripts/stamp-assets.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:fonts": "node scripts/download-fonts.mjs",
    "build:assets": "npm run build:images && npm run build:vendor && npm run build:fonts",
    "minify": "node scripts/minify-assets.mjs",
    "lint:css": "node scripts/check-css-colors.mjs",
    "lint:js": "eslint js",
    "typecheck": "tsc -p jsconfig.json",
    "gen:types": "bash scripts/gen-db-types.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@supabase/supabase-js": "^2.118.0",
    "chart.js": "^4.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "nunjucks": "^3.2.4",
    "pdfjs-dist": "^6.4.299",
    "stylelint": "^16.26.1",
    "typescript": "^7.0.2"
  }
}
